{
  "name": "agents-repo",
  "version": "1.15.0",
  "description": "Official CLI for installing and managing agents-repo packages.",
  "license": "MIT",
  "author": "Agents Repo (https://github.com/agents-repo)",
  "keywords": [
    "agents",
    "agents-repo",
    "cli",
    "copilot",
    "github-copilot",
    "cursor",
    "claude-code",
    "openai-codex",
    "codex",
    "registry"
  ],
  "type": "module",
  "bin": {
    "agents-repo": "dist/bin/agents-repo.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agents-repo/cli.git"
  },
  "bugs": {
    "url": "https://github.com/agents-repo/cli/issues"
  },
  "homepage": "https://github.com/agents-repo/cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "env:check": "node scripts/validate-env.mjs",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/.*/**/*.md\"",
    "lint:yaml": "node scripts/lint-yaml.js",
    "lint:all": "markdownlint-cli2 \"**/*.md\" \"**/.*/**/*.md\" && eslint . && node scripts/lint-yaml.js",
    "sync:ide-instructions": "node scripts/sync-ide-instructions.mjs",
    "agents:install": "node scripts/run-published-agents-repo.mjs install",
    "agents:update": "node scripts/run-published-agents-repo.mjs update",
    "test:sync": "node --test test/sync-ide-instructions.test.mjs test/validate-env.test.mjs",
    "check:secrets": "bash scripts/check-secrets.sh",
    "pretest": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "publish:local": "HUSKY=0 npm publish --access public",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "adm-zip": "^0.6.0",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.12.3",
    "@types/semver": "^7.7.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.0",
    "markdownlint-cli2": "^0.23.0",
    "semantic-release": "^25.0.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {}
}
